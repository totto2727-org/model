name = "totto2727/serde"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/totto2727-org/serde"

license = "MIT"

keywords = [ "serde", "json", "codegen" ]

description = "Attribute-driven static JSON codec generation for MoonBit"

source = "src"

preferred_target = "native"

import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/lexer@0.4.5",
  "moonbitlang/parser@0.4.9",
  "moonbitlang/x@0.5.7",
  "moonbitstack/moonip@0.2.0",
  "moonbitstack/moonmail@0.2.0",
  "moonbitstack/moonucd@0.2.0",
  "moonbitstack/moonurl@0.3.0",
  "sssssurf/dialnumber@0.10.0",
}
