///|
pub const GENERATED_HEADER = "// Generated by totto2727/serde --validate. Do not edit."

///|
pub suberror GenerateError {
  GenerateError(String)
}

///|
priv enum Rule {
  Length(Int32?, Int32?)
  Range(Int32?, Int32?)
  Required
  Dive
  Inner(Array[Rule])
  Custom(String)
}

///|
fn fail(at : String, message : String) -> Unit raise GenerateError {
  raise GenerateError("\{at}: \{message}")
}

///|
fn options(
  attrs : @list.List[@attribute.Attribute],
) -> (String, @list.List[@attribute.Prop])? raise GenerateError {
  let mut result = None
  for attr in attrs {
    let at = Show::to_string(attr.loc)
    let props = match attr.parsed {
      Some(Ident({ qual: Some("custom"), name: "garde", })) => @list.List([])
      Some(Apply({ qual: Some("custom"), name: "garde", }, props)) => props
      None if attr.raw.strip_prefix("#custom.garde") is Some(suffix) &&
        suffix.trim_start().has_prefix("(") =>
        raise GenerateError("\{at}: malformed #custom.garde attribute")
      _ => continue
    }
    if result is Some(_) {
      fail(at, "repeated #custom.garde attribute")
    }
    result = Some((at, props))
  }
  result
}

///|
fn parse_bounds(
  props : @list.List[@attribute.Prop],
  at : String,
  kind : String,
) -> (Int32?, Int32?) raise GenerateError {
  let mut min = None
  let mut max = None
  let mut equal = None
  for prop in props {
    guard prop is Labeled(key, String(raw)) else {
      raise GenerateError(
        "\{at}: \{kind} expects quoted integer bounds (min, max, or equal)",
      )
    }
    let value = @string.parse_int(raw[:], radix=10) catch {
      _ => raise GenerateError("\{at}: \{key} must be a decimal Int")
    }
    if kind == "length" && value < 0 {
      fail(at, "length bounds must be non-negative")
    }
    match key {
      "min" if min is None => min = Some(value)
      "max" if max is None => max = Some(value)
      "equal" if equal is None => equal = Some(value)
      _ => fail(at, "unknown or repeated \{kind} bound: \{key}")
    }
  }
  match (min, max, equal) {
    (None, None, Some(value)) => (Some(value), Some(value))
    (_, _, Some(_)) =>
      raise GenerateError("\{at}: equal cannot be combined with min or max")
    (None, None, None) => raise GenerateError("\{at}: \{kind} requires a bound")
    (Some(a), Some(b), None) if a > b =>
      raise GenerateError("\{at}: min cannot exceed max")
    _ => (min, max)
  }
}

///|
fn parse_rules(
  props : @list.List[@attribute.Prop],
  at : String,
) -> Array[Rule] raise GenerateError {
  let rules = []
  for prop in props {
    let rule : Rule = match prop {
      Expr(Ident({ qual: None, name: "required", })) => Required
      Expr(Ident({ qual: None, name: "dive", })) => Dive
      Expr(Apply({ qual: None, name: "length", }, bounds)) => {
        let (min, max) = parse_bounds(bounds, at, "length")
        Length(min, max)
      }
      Expr(Apply({ qual: None, name: "range", }, bounds)) => {
        let (min, max) = parse_bounds(bounds, at, "range")
        Range(min, max)
      }
      Expr(Apply({ qual: None, name: "inner", }, inner)) =>
        Inner(parse_rules(inner, at))
      Expr(
        Apply(
          { qual: None, name: "custom", },
          More(Expr(Ident({ qual: None, name, })), tail=Empty),
        ),
      ) => Custom(name)
      _ => fail_rule(at, "unknown or invalid garde rule")
    }
    rules.push(rule)
  }
  if rules.is_empty() {
    fail(at, "expected at least one garde rule")
  }
  rules
}

///|
fn fail_rule(at : String, message : String) -> Rule raise GenerateError {
  raise GenerateError("\{at}: \{message}")
}

///|
fn option_value(ty : @syntax.Type) -> @syntax.Type? {
  match ty {
    Option(ty~, ..)
    | Name(
      constr_id={ id: Ident(name="Option"), .. },
      tys=More(ty, tail=Empty),
      ..
    ) => Some(ty)
    _ => None
  }
}

///|
fn bound_expr(value : Int32?) -> String {
  match value {
    None => "None"
    Some(n) => "Some(\{n})"
  }
}

///|
fn emit_rules(
  out : StringBuilder,
  ty : @syntax.Type,
  rules : Array[Rule],
  at : String,
  p : String,
) -> Unit raise GenerateError {
  for rule in rules {
    if rule is Required {
      guard option_value(ty) is Some(_) else {
        raise GenerateError("\{at}: required expects Option")
      }
      out.write_string(
        "if \{p}value is None { \{p}report.add(\{p}path, \"is required\") }\n",
      )
    } else {
      emit_rule(out, ty, rule, at, p)
    }
  }
}

///|
fn emit_rule(
  out : StringBuilder,
  ty : @syntax.Type,
  rule : Rule,
  at : String,
  p : String,
) -> Unit raise GenerateError {
  if option_value(ty) is Some(inner) {
    out.write_string("if \{p}value is Some(\{p}value) {\n")
    emit_rule(out, inner, rule, at, p)
    out.write_string("}\n")
    return
  }
  let call = match rule {
    Length(min, max) =>
      "@garde.length(\{p}value, \{bound_expr(min)}, \{bound_expr(max)})"
    Range(min, max) =>
      "@garde.range(\{p}value, \{bound_expr(min)}, \{bound_expr(max)})"
    Custom(function) => "\{function}(\{p}value)"
    Dive => {
      out.write_string(
        "@garde.Validate::collect(\{p}value, \{p}report, \{p}path)\n",
      )
      return
    }
    Inner(rules) => {
      guard ty
        is Name(
          constr_id={
            id: Ident(name="Array" | "ReadOnlyArray" | "FixedArray"),
            ..
          },
          tys=More(item, tail=Empty),
          ..
        ) else {
        raise GenerateError(
          "\{at}: inner expects an Array, ReadOnlyArray, or FixedArray",
        )
      }
      out.write_string(
        "for \{p}index, \{p}value in \{p}value {\nlet \{p}path = \{p}path.index(\{p}index)\n",
      )
      emit_rules(out, item, rules, at, p)
      out.write_string("}\n")
      return
    }
    Required => abort("required is emitted before unwrapping Option")
  }
  out.write_string(
    "if \{call} is Some(message) { \{p}report.add(\{p}path, message) }\n",
  )
}

///|
fn emit_declaration(
  out : StringBuilder,
  decl : @syntax.TypeDecl,
  seen : Map[String, Bool],
  p : String,
) -> Unit raise GenerateError {
  let attrs = options(decl.attrs)
  guard decl.components is Record(fields~, ..) else {
    if attrs is Some((at, _)) {
      fail(at, "#custom.garde supports record structs only")
    }
    if decl.components is Variant(variants) {
      for variant in variants {
        if options(variant.attrs) is Some((at, _)) {
          fail(at, "#custom.garde supports record fields only")
        }
      }
    }
    return
  }
  let allow_unvalidated = match attrs {
    Some((_, Empty)) | None => false
    Some(
      (
        _,
        More(
          Expr(Ident({ qual: None, name: "allow_unvalidated", })),
          tail=Empty,
        ),
      ),
    ) => true
    Some((at, _)) =>
      raise GenerateError(
        "\{at}: expected allow_unvalidated or no struct options",
      )
  }
  if attrs is Some((at, _)) {
    if !decl.params.is_empty() {
      fail(at, "#custom.garde does not yet support generic structs")
    }
    if seen.contains(decl.tycon) {
      fail(at, "duplicate garde struct: \{decl.tycon}")
    }
    seen[decl.tycon] = true
  }
  let body = StringBuilder()
  for field in fields {
    match options(field.attrs) {
      None if attrs is Some(_) && !allow_unvalidated =>
        fail(
          Show::to_string(field.loc),
          "field needs a garde rule or #custom.garde(skip)",
        )
      None => ()
      Some((at, _)) if attrs is None =>
        fail(at, "field #custom.garde requires #custom.garde on its struct")
      Some((_, More(Expr(Ident({ qual: None, name: "skip", })), tail=Empty))) =>
        ()
      Some((at, props)) => {
        let rules = parse_rules(props, at)
        let field_name = field.name.label
        body.write_string(
          "{\nlet \{p}value = \{p}self.\{field_name}\nlet \{p}path = \{p}path.field(\"\{field_name}\")\n",
        )
        emit_rules(body, field.ty, rules, at, p)
        body.write_string("}\n")
      }
    }
  }
  if attrs is Some(_) {
    let visibility = if decl.type_vis is Priv(..) { "" } else { "pub " }
    let body = body.to_string()
    let args = if body.is_empty() {
      "_, _, _"
    } else {
      "\{p}self, \{p}report, \{p}path"
    }
    out.write_string(
      "\{visibility}impl @garde.Validate for \{decl.tycon} with fn collect(\{args}) {\n\{body}}\n",
    )
  }
}

///|
/// Generate validation implementations without changing any JSON codecs.
pub fn generate_many(
  sources : Array[(String, String)],
) -> String raise GenerateError {
  let out = StringBuilder()
  let seen = Map([])
  for source in sources {
    let (name, text) = source
    // Do not shadow a custom validator's function name.
    let mut prefix = "garde_"
    while text.contains(prefix) {
      prefix += "_"
    }
    let (items, reports) = @parser.parse_string(text, name~)
    if !reports.is_empty() {
      raise GenerateError(Show::to_string(reports[0]))
    }
    for item in items {
      if item is TopTypeDef(decl) {
        emit_declaration(out, decl, seen, prefix)
      }
    }
  }
  let (impls, reports) = @parser.parse_string(
    out.to_string(),
    name="garde.generated.mbt",
  )
  if !reports.is_empty() {
    raise GenerateError(Show::to_string(reports[0]))
  }
  GENERATED_HEADER + "\n" + @fmt.impls_to_string(impls)
}
