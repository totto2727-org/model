///|
pub fn Allocation::collect_with(
  garde__self : Allocation,
  garde__context : Policy,
  garde__report : @garde.Report,
  garde__path : @garde.Path,
) -> Unit {
  let garde__value = garde__self.count
  let garde__path = garde__path.field("count")
  if @garde.range(garde__value, Some(0), None) is Some(message) {
    garde__report.add(garde__path, message)
  }
  if check_count(garde__value, garde__context) is Some(message) {
    garde__report.add(garde__path, message)
  }
}

///|
pub fn Allocation::validate_with(
  self : Allocation,
  context : Policy,
) -> Result[Unit, @garde.Report] {
  @garde.validate_using(self, (value, report, path) => {
    value.collect_with(context, report, path)
  })
}

