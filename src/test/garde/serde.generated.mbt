  if @garde.range(garde__value, Some(0), None) is Some(message) {
    garde__report.add(garde__path, message)
  }
  if check_count(garde__value, garde__context) is Some(message) {
    garde__report.add(garde__path, message)
  }
}

///|
pub fn Allocation::validate_with(
  self : Allocation,
  context : Policy,
) -> Result[Unit, @garde.Report] {
  @garde.validate_using(self, (value, report, path) => {
    value.collect_with(context, report, path)
  })
}

///|
pub fn Request::collect_with(
  garde__self : Request,
  garde__context : Policy,
  garde__report : @garde.Report,
  garde__path : @garde.Path,
) -> Unit {
  let garde__value = garde__self.allocations
  let garde__path = garde__path.field("allocations")
  for garde__index, garde__value in garde__value {
    let garde__path = garde__path.index(garde__index)
    garde__value.collect_with(garde__context, garde__report, garde__path)
  }
}

///|
pub fn Request::validate_with(
  self : Request,
  context : Policy,
) -> Result[Unit, @garde.Report] {
  @garde.validate_using(self, (value, report, path) => {
    value.collect_with(context, report, path)
  })
}

///|
pub impl @garde.Validate for Confirmation with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  {
    let garde__value = garde__self.repeated
    let garde__path = garde__path.field("repeated")
    if garde__value != garde__self.code {
      garde__report.add(garde__path, "must match code")
    }
  }
  let garde__value = garde__self.code
  let garde__path = garde__path.field("code")
  if garde__value is Some(garde__value) {
    if @garde.pattern(garde__value, "^ID-[0-9]+\\.$") is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
}

///|
pub impl[T : Eq] @garde.Validate for Same[T] with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  let garde__value = garde__self.repeated
  let garde__path = garde__path.field("repeated")
  if garde__value != garde__self.original {
    garde__report.add(garde__path, "must match original")
  }
}

///|
pub impl @garde.Validate for ContactDetails with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  {
    let garde__value = garde__self.email
    let garde__path = garde__path.field("email")
    if @garde.email(garde__value) is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.website
    let garde__path = garde__path.field("website")
    if @garde.url(garde__value) is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.addresses
    let garde__path = garde__path.field("addresses")
    for garde__index, garde__value in garde__value {
      let garde__path = garde__path.index(garde__index)
      if @garde.ip(garde__value) is Some(message) {
        garde__report.add(garde__path, message)
      }
    }
  }
  {
    let garde__value = garde__self.v4
    let garde__path = garde__path.field("v4")
    if garde__value is Some(garde__value) {
      if @garde.ipv4(garde__value) is Some(message) {
        garde__report.add(garde__path, message)
      }
    }
  }
  {
    let garde__value = garde__self.v6
    let garde__path = garde__path.field("v6")
    if garde__value is Some(garde__value) {
      if @garde.ipv6(garde__value) is Some(message) {
        garde__report.add(garde__path, message)
      }
    }
  }
  let garde__value = garde__self.phone
  let garde__path = garde__path.field("phone")
  if garde__value is Some(garde__value) {
    if @garde.phone_number(garde__value) is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
}

///|
pub impl @garde.Validate for ProductCode with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  match garde__self {
    ProductCode(garde__inner) => {
      let garde__value = garde__inner
      let garde__path = garde__path
      if !is_uppercase_code(garde__value) {
        garde__report.add(garde__path, "does not match the pattern")
      }
    }
  }
}

///|
pub impl @garde.Validate for OrderChecks with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  {
    let garde__value = garde__self.product
    let garde__path = garde__path.field("product")
    if is_strict(garde__self) {
      if garde__value is None {
        garde__report.add(garde__path, "is required")
      }
      if garde__value is Some(garde__value) {
        @garde.Validate::collect(garde__value, garde__report, garde__path)
      }
    }
  }
  {
    let garde__value = garde__self.quantity
    let garde__path = garde__path.field("quantity")
    if @garde.range(garde__value, Some(MINIMUM_WIDE), None) is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.multiplier
    let garde__path = garde__path.field("multiplier")
    if @garde.range(garde__value, Some(0.5), Some(2.5)) is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  let garde__value = garde__self.allocations
  let garde__path = garde__path.field("allocations")
  for garde__index, garde__value in garde__value {
    let garde__path = garde__path.index(garde__index)
    garde__value.collect_with(garde__self.policy, garde__report, garde__path)
  }
}

///|
pub impl @garde.Validate for NumericRanges with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  {
    let garde__value = garde__self.wide
    let garde__path = garde__path.field("wide")
    if @garde.range(
        garde__value,
        Some(9007199254740993),
        Some(9007199254740994),
      )
      is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.unsigned
    let garde__path = garde__path.field("unsigned")
    if @garde.range(
        garde__value,
        Some(18446744073709551614),
        Some(18446744073709551615),
      )
      is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.huge
    let garde__path = garde__path.field("huge")
    if @garde.range(
        garde__value,
        Some(1000000000000000000000000000001),
        Some(1000000000000000000000000000001),
      )
      is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.single
    let garde__path = garde__path.field("single")
    if @garde.range(garde__value, Some(1.00000002), Some(1.00000001))
      is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  {
    let garde__value = garde__self.double
    let garde__path = garde__path.field("double")
    if @garde.range(garde__value, Some(-0.125), Some(2_000.0)) is Some(message) {
      garde__report.add(garde__path, message)
    }
  }
  let garde__value = garde__self.base16
  let garde__path = garde__path.field("base16")
  if @garde.range(garde__value, Some(0x10), Some(0x20)) is Some(message) {
    garde__report.add(garde__path, message)
  }
}

///|
pub impl @garde.Validate for ReversedRange with fn collect(
  garde__self,
  garde__report,
  garde__path,
) {
  let garde__value = garde__self.wide
  let garde__path = garde__path.field("wide")
  if @garde.range(garde__value, Some(9007199254740993), Some(9007199254740992))
    is Some(message) {
    garde__report.add(garde__path, message)
  }
}

///|
pub impl[T] @garde.Validate for Endpoint[T] with fn collect(
  garde_self,
  garde_report,
  garde_path,
) {
  {
    let garde_value = garde_self.url
    let garde_path = garde_path.field("url")
    if @garde.url(garde_value) is Some(message) {
      garde_report.add(garde_path, message)
    }
  }
  {
    let garde_value = garde_self.allowed_ip
    let garde_path = garde_path.field("allowed_ip")
    if garde_value is Some(garde_value) {
      if @garde.ipv4(garde_value) is Some(message) {
        garde_report.add(garde_path, message)
      }
    }
  }
  {
    let garde_value = garde_self.phone
    let garde_path = garde_path.field("phone")
    if garde_value is Some(garde_value) {
      if @garde.phone_number(garde_value) is Some(message) {
        garde_report.add(garde_path, message)
      }
    }
  }
  let garde_value = garde_self.name
  let garde_path = garde_path.field("name")
  if @garde.length(garde_value, Some(1), None) is Some(message) {
    garde_report.add(garde_path, message)
  }
}

///|
///
pub(all) struct EndpointDecoded[T] {
  url : @garde.Url
  allowed_ip : @garde.Addr?
  phone : @garde.PhoneNumber?
  name : String
  metadata : T
}

///|
pub impl[T] @garde.Decode for Endpoint[T]

///|
pub impl[T] @garde.Encode for EndpointDecoded[T]

///|
pub fn[T] Endpoint::codec() -> @garde.Codec[Endpoint[T], EndpointDecoded[T]] {
  @garde.Codec::new(
    fn(garde_value) {
      guard @garde.parse_url(garde_value.url) is Some(garde_decoded_url) else {
        return Err(
          @garde.conversion_failure("url", "could not convert validated value"),
        )
      }
      let garde_decoded_allowed_ip = match garde_value.allowed_ip {
        None => None
        Some(garde_item) => {
          guard @garde.parse_ip(garde_item) is Some(garde_parsed) else {
            return Err(
              @garde.conversion_failure(
                "allowed_ip", "could not convert validated value",
              ),
            )
          }
          Some(garde_parsed)
        }
      }
      let garde_decoded_phone = match garde_value.phone {
        None => None
        Some(garde_item) => {
          guard @garde.parse_phone_number(garde_item) is Some(garde_parsed) else {
            return Err(
              @garde.conversion_failure(
                "phone", "could not convert validated value",
              ),
            )
          }
          Some(garde_parsed)
        }
      }
      Ok(EndpointDecoded::{
        url: garde_decoded_url,
        allowed_ip: garde_decoded_allowed_ip,
        phone: garde_decoded_phone,
        name: garde_value.name,
        metadata: garde_value.metadata,
      })
    },
    fn(garde_value) {
      Endpoint::{
        url: garde_value.url.encode(),
        allowed_ip: garde_value.allowed_ip.map(garde_item => {
          garde_item.to_string()
        }),
        phone: garde_value.phone.map(garde_item => garde_item.to_string()),
        name: garde_value.name,
        metadata: garde_value.metadata,
      }
    },
  )
}
