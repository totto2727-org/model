pub extend Allocation with ToJson::{to_json}

///|
pub fn Request::collect_with(
  garde__self : Request,
  garde__context : Policy,
  garde__report : @garde.Report,
  garde__path : @garde.Path,
) -> Unit {
  let garde__value = garde__self.allocations
  let garde__path = garde__path.field("allocations")
  for garde__index, garde__value in garde__value {
    let garde__path = garde__path.index(garde__index)
    garde__value.collect_with(garde__context, garde__report, garde__path)
  }
}

///|
pub fn Request::validate_with(
  self : Request,
  context : Policy,
) -> Result[Unit, @garde.Report] {
  @garde.validate_using(self, (value, report, path) => {
    value.collect_with(context, report, path)
  })
}

