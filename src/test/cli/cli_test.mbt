///|
async fn cli(dir : String, argv : ArrayView[String]) -> (Int32, String, String) {
  let (code, out, err) = @process.collect_output("serde-gen", argv, cwd=dir)
  (code, out.text(), err.text())
}

///|
async fn model(dir : String, file : String, name : String) -> Unit {
  @fs.write_file("\{dir}/\{file}", "#custom.serde\nstruct \{name}(Int)\n")
}

///|
async test "serde-gen - usage goes to stdout for help and stderr for bad arguments" {
  let dir = @fs.tmpdir(prefix="serde-gen-test")
  defer @fs.rmdir(dir, recursive=true)
  let usage = "Usage: serde-gen [--validate] INPUT... --output OUTPUT\n       serde-gen [--validate] --package DIR\n"
  assert_eq(cli(dir, ["--help"]), (0, usage, ""))
  assert_eq(cli(dir, ["first.mbt"]), (2, "", usage))
}

///|
async test "serde-gen --validate has independent package output and overwrite protection" {
  let dir = @fs.tmpdir(prefix="serde-gen-test")
  defer @fs.rmdir(dir, recursive=true)
  @fs.write_file("\{dir}/moon.pkg", "")
  @fs.write_file(
    "\{dir}/models.mbt",
    "#custom.serde\n#custom.garde\nstruct Both {\n  #custom.garde(range(min=\"0\"))\n  value : Int\n}\n",
  )
  assert_eq(cli(dir, ["--package", "."]), (0, "", ""))
  let codecs = @fs.read_file("\{dir}/serde.generated.mbt").text()
  assert_eq(cli(dir, ["--validate", "--package", "."]), (0, "", ""))
  let validation = @fs.read_file("\{dir}/garde.generated.mbt").text()
  assert_true(codecs.contains("impl ToJson for Both"))
  assert_false(codecs.contains("@garde.Validate"))
  assert_true(validation.contains("impl @garde.Validate for Both"))
  assert_false(validation.contains("ToJson"))
  let (status, _, err) = cli(dir, [
    "--validate", "models.mbt", "--output", "serde.generated.mbt",
  ])
  assert_eq(status, 1)
  assert_true(err.contains("refusing to overwrite"), msg=err)
  assert_eq(@fs.read_file("\{dir}/serde.generated.mbt").text(), codecs)
}

///|
async fn guarded_model(dir : String, file : String, name : String) -> Unit {
  @fs.write_file(
    "\{dir}/\{file}",
    "#custom.garde(field(index=\"0\", ascii))\nstruct \{name}(String)\n",
  )
}

///|
async test "serde-gen --validate discovers added, edited, and removed package sources" {
  let dir = @fs.tmpdir(prefix="serde-gen-test")
  defer @fs.rmdir(dir, recursive=true)
  @fs.mkdir("\{dir}/child")
  @fs.write_file("\{dir}/moon.pkg", "")
  @fs.write_file("\{dir}/child/moon.pkg", "")
  model(dir, "codec.mbt", "CodecOnly")
  guarded_model(dir, "original.mbt", "Original")
  for
    file in [
      "child/nested.mbt", "ignored_test.mbt", "ignored.js.mbt", "already.generated.mbt",
    ] {
    guarded_model(dir, file, "Ignored")
  }
  let argv = ["--validate", "--package", "."]
  let output = "\{dir}/garde.generated.mbt"
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  let original = @fs.read_file(output).text()
  assert_true(original.contains("impl @garde.Validate for Original "))
  assert_false(original.contains("Ignored"))
  assert_false(original.contains("CodecOnly"))

  guarded_model(dir, "new.mbt", "Added")
  guarded_model(dir, "original.mbt", "Edited")
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  let updated = @fs.read_file(output).text()
  assert_true(updated.contains("impl @garde.Validate for Added "))
  assert_true(updated.contains("impl @garde.Validate for Edited "))
  assert_false(updated.contains("Original"))

  @fs.remove("\{dir}/new.mbt")
  @fs.remove("\{dir}/original.mbt")
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  assert_eq(
    @fs.read_file(output).text(),
    "// Generated by totto2727/serde --validate. Do not edit.\n",
  )
}

///|
async test "serde-gen - explicit inputs keep order without rewriting identical output" {
  let dir = @fs.tmpdir(prefix="serde-gen-test")
  defer @fs.rmdir(dir, recursive=true)
  model(dir, "first.mbt", "First")
  model(dir, "second.mbt", "Second")
  let argv = ["first.mbt", "second.mbt", "--output", "output.mbt"]
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  let path = "\{dir}/output.mbt"
  let before = @fs.read_file(path).text()
  guard before.find("impl ToJson for First ") is Some(first) else {
    fail("missing First implementation")
  }
  guard before.find("impl ToJson for Second ") is Some(second) else {
    fail("missing Second implementation")
  }
  assert_true(first < second)
  let modified = @fs.mtime(path)
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  assert_eq(@fs.read_file(path).text(), before)
  assert_eq(@fs.mtime(path), modified)
}

///|
async test "serde-gen - no overwrite and located errors on invalid sources" {
  let dir = @fs.tmpdir(prefix="serde-gen-test")
  defer @fs.rmdir(dir, recursive=true)
  model(dir, "first.mbt", "First")
  @fs.write_file("\{dir}/handwritten.mbt", "handwritten\n")
  assert_eq(
    cli(dir, ["first.mbt", "--output", "handwritten.mbt"]),
    (1, "", "serde-gen: refusing to overwrite handwritten.mbt\n"),
  )
  assert_eq(@fs.read_file("\{dir}/handwritten.mbt").text(), "handwritten\n")
  @fs.write_file(
    "\{dir}/broken.mbt",
    "#custom.serde\nstruct Broken {\n  #custom.serde(path=[])\n  value : Int\n}\n",
  )
  let (status, _, err) = cli(dir, [
    "broken.mbt", "--output", "broken.generated.mbt",
  ])
  assert_eq(status, 1)
  assert_true(err.has_prefix("serde-gen: broken.mbt-3:3"), msg=err)
  assert_true(
    err.has_suffix(": path must be a non-empty array of string keys\n"),
    msg=err,
  )
  assert_false(@fs.exists("\{dir}/broken.generated.mbt"))
  model(dir, "duplicate.mbt", "First")
  let (status, _, err) = cli(dir, [
    "first.mbt", "duplicate.mbt", "--output", "duplicate.generated.mbt",
  ])
  assert_eq(status, 1)
  assert_true(err.has_prefix("serde-gen: duplicate.mbt-"), msg=err)
  assert_true(
    err.contains(
      ": duplicate annotated type First (first defined at first.mbt-",
    ),
    msg=err,
  )
  assert_false(@fs.exists("\{dir}/duplicate.generated.mbt"))
}

///|
async test "serde-gen - package discovery is ordered and reflects additions, edits, and removals" {
  let dir = @fs.tmpdir(prefix="serde-gen-test")
  defer @fs.rmdir(dir, recursive=true)
  let pkg = "\{dir}/my package"
  @fs.mkdir("\{pkg}/child", recursive=true)
  @fs.write_file("\{pkg}/moon.pkg", "")
  @fs.write_file("\{pkg}/child/moon.pkg", "")
  model(pkg, "z.mbt", "Second")
  model(pkg, "a.mbt", "First")
  for
    file in [
      "child/ignored.mbt", "ignored.generated.mbt", "ignored_test.mbt", "ignored.js.mbt",
    ] {
    model(pkg, file, "First")
  }
  @fs.write_file("\{pkg}/unmarked.mbt", "not valid MoonBit, and has no marker")
  assert_eq(
    cli(dir, [
      "my package/a.mbt", "my package/z.mbt", "--output", "expected.generated.mbt",
    ]),
    (0, "", ""),
  )
  let argv = ["--package", "my package"]
  let output = "\{pkg}/serde.generated.mbt"
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  assert_eq(
    @fs.read_file(output).text(),
    @fs.read_file("\{dir}/expected.generated.mbt").text(),
  )
  model(pkg, "a.mbt", "Edited")
  model(pkg, "new.mbt", "First")
  @fs.remove("\{pkg}/z.mbt")
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  let updated = @fs.read_file(output).text()
  assert_true(updated.contains("impl ToJson for Edited "))
  assert_true(updated.contains("impl ToJson for First "))
  assert_false(updated.contains("impl ToJson for Second "))
  @fs.remove("\{pkg}/a.mbt")
  @fs.remove("\{pkg}/new.mbt")
  assert_eq(cli(dir, argv[:]), (0, "", ""))
  assert_eq(
    @fs.read_file(output).text(),
    "// Generated by totto2727/serde. Do not edit.\n",
  )
}
