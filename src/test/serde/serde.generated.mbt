///|
pub impl[T : ToJson, U : ToJson] ToJson for GenericAdjacent[T, U] with fn to_json(
  self,
) {
  match self {
    Empty => {
      let tagged : Map[String, Json] = { "type": Json::string("Empty") }
      Json::object(tagged)
    }
    Positional(inner) => {
      let tagged : Map[String, Json] = { "type": Json::string("Positional") }
      let payload = ToJson::to_json(inner)
      tagged.set("data", payload)
      Json::object(tagged)
    }
    Named(value=field_value) => {
      let tagged : Map[String, Json] = { "type": Json::string("Named") }
      let obj : Map[String, Json] = Map([])
      obj.set("value", ToJson::to_json(field_value))
      let payload = Json::object(obj)
      tagged.set("data", payload)
      Json::object(tagged)
    }
  }
}

///|
fn[T, U] serde_decode_GenericAdjacent_0(
  value : Json,
  path : @json.JsonPath,
) -> GenericAdjacent[T, U] raise @json.JsonDecodeError {
  if value != Json::null() {
    @serde.invalid(path, "expected null for a unit variant")
  }
  Empty
}

///|
fn[T : @json.FromJson, U] serde_decode_GenericAdjacent_1(
  value : Json,
  path : @json.JsonPath,
) -> GenericAdjacent[T, U] raise @json.JsonDecodeError {
  let inner : T = @json.from_json(value, path~)
  Positional(inner)
}

///|
fn[T, U : @json.FromJson] serde_decode_GenericAdjacent_2(
  value : Json,
  path : @json.JsonPath,
) -> GenericAdjacent[T, U] raise @json.JsonDecodeError {
  let obj = @serde.object(value, path)
  let field_value : U = match obj.get("value") {
    Some(value) => @json.from_json(value, path=path.add_key("value"))
    None => @serde.missing_field(path.add_key("value"), "value")
  }
  Named(value=field_value)
}

///|
pub impl[T : @json.FromJson, U : @json.FromJson] @json.FromJson for GenericAdjacent[
  T,
  U,
] with fn from_json(value, path) {
  let obj = @serde.object(value, path)
  let tag = @serde.discriminator(obj, "type", path)
  let content = obj.get("data")
  match tag {
    "Empty" => {
      @serde.unit(content, path)
      serde_decode_GenericAdjacent_0(Json::null(), path)
    }
    "Positional" => {
      let path = path.add_key("data")
      serde_decode_GenericAdjacent_1(@serde.payload(content, path), path)
    }
    "Named" => {
      let path = path.add_key("data")
      serde_decode_GenericAdjacent_2(@serde.payload(content, path), path)
    }
    _ => @serde.invalid(path.add_key("type"), "unknown enum variant: " + tag)
  }
}

